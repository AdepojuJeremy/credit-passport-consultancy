# Optional canonical public-site override used for metadata, sitemap and robots output.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL can supply the production origin automatically.
# Example for custom hosting: https://consulting.creditpassport.example
NEXT_PUBLIC_SITE_URL=

# Consultation intake
# Point this at a secure server-side webhook, CRM intake endpoint, or automation workflow.
CONSULTATION_WEBHOOK_URL=

# Optional bearer token sent only from the server route to the webhook destination.
CONSULTATION_WEBHOOK_BEARER_TOKEN=

# Optional conversion measurement destination.
# Receives only named funnel events, route path, session-scoped UTM values and bounded event metadata.
MEASUREMENT_WEBHOOK_URL=

# Optional bearer token sent only from the server-side measurement route.
MEASUREMENT_WEBHOOK_BEARER_TOKEN=
